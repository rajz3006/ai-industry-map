# Finnhub API key (free tier). Get one at https://finnhub.io/register
# Server-only — never exposed to the client. Required for live quotes, profile,
# and earnings; without it the app still builds and runs, showing
# "Set FINNHUB_API_KEY to enable live data" instead of prices.
FINNHUB_API_KEY=

# Alpaca Market Data API keys (paper OR live account both work — this is the
# data API, not the trading API). Required for the stock-detail chart's price
# history: Finnhub's free tier no longer serves /stock/candle (403), so this
# app uses Alpaca's IEX-feed bars endpoint instead. Get keys at
# https://app.alpaca.markets (Paper Trading -> API Keys).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Optional override; defaults to https://data.alpaca.markets
ALPACA_DATA_BASE_URL=
